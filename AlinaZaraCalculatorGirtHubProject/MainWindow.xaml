<Window x:Class="AlinaZaraCalculatorGirtHubProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Калькулятор Алины и Зары" Height="400" Width="300" WindowStartupLocation="CenterScreen">

	<Grid Background="#F3F3F3" Margin="10">
		<!-- Настройка строк и столбцов для кнопок -->
		<Grid.RowDefinitions>
			<RowDefinition Height="2*" />
			<RowDefinition Height="*" />
			<RowDefinition Height="*" />
			<RowDefinition Height="*" />
			<RowDefinition Height="*" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>
		<!-- Экран калькулятора (Алина обращается к нему в коде по имени DisplayTextBox) -->
		<TextBlock x:Name="DisplayTextBox"
                   Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4"
                   Text="0" FontSize="48" TextAlignment="Right"
                   VerticalAlignment="Bottom" Margin="10" />
		<!-- Строка 1 -->
		<Button Content="C" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="2" FontSize="20" Background="#FFCDD2" Click="Button_Clear_Click"/>
		<Button Content="/" Grid.Row="1" Grid.Column="3" Margin="2" FontSize="20" Background="#BBDEFB" Click="Button_Operation_Click"/>
		<!-- Строка 2 -->
		<Button Content="7" Grid.Row="2" Grid.Column="0" Margin="2" FontSize="20" Background="White" Click="Button_Number_Click"/>
		<Button Content="8" Grid.Row="2" Grid.Column="1" Margin="2" FontSize="20" Background="White" Click="Button_Number_Click"/>
		<Button Content="9" Grid.Row="2" Grid.Column="2" Margin="2" FontSize="20" Background="White" Click="Button_Number_Click"/>
		<Button Content="*" Grid.Row="2" Grid.Column="3" Margin="2" FontSize="20" Background="#BBDEFB" Click="Button_Operation_Click"/>
		<!-- Строка 3 -->
		<Button Content="4" Grid.Row="3" Grid.Column="0" Margin="2" FontSize="20" Background="White" Click="Button_Number_Click"/>
		<Button Content="5" Grid.Row="3" Grid.Column="1" Margin="2" FontSize="20" Background="White" Click="Button_Number_Click"/>
		<Button Content="6" Grid.Row="3" Grid.Column="2" Margin="2" FontSize="20" Background="White" Click="Button_Number_Click"/>
		<Button Content="-" Grid.Row="3" Grid.Column="3" Margin="2" FontSize="24" Background="#BBDEFB" Click="Button_Operation_Click"/>

		<!-- Строка 4 -->
		<Button Content="1" Grid.Row="4" Grid.Column="0" Margin="2" FontSize="20" Background="White" Click="Button_Number_Click"/>
		<Button Content="2" Grid.Row="4" Grid.Column="1" Margin="2" FontSize="20" Background="White" Click="Button_Number_Click"/>
		<Button Content="3" Grid.Row="4" Grid.Column="2" Margin="2" FontSize="20" Background="White" Click="Button_Number_Click"/>
		<Button Content="+" Grid.Row="4" Grid.Column="3" Margin="2" FontSize="20" Background="#BBDEFB" Click="Button_Operation_Click"/>
		<!-- Строка 5 -->
		<Button Content="0" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="2" FontSize="20" Background="White" Click="Button_Number_Click"/>
		<Button Content="." Grid.Row="5" Grid.Column="2" Margin="2" FontSize="24" Background="White" Click="Button_Number_Click"/>
		<Button Content="=" Grid.Row="5" Grid.Column="3" Margin="2" FontSize="20" Background="#C8E6C9" Click="Button_Equals_Click"/>
	</Grid>
</Window>